<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	  <ImplicitUsings>enable</ImplicitUsings>
	  <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
	  <Title>CacheLine.CPU.SCU</Title>
	  <Authors>Vyacheslav Sapozhnikov</Authors>
	  <Description>Cross-platform lib to get CPU cache line size; (win, linux, mac)</Description>
	  <Copyright>Copyright (c) 2026 VSapozhnikov</Copyright>
	  <PackageTags>CPU; Cache Line; Windows; Linux; Mac; System; Info; Tool; Util</PackageTags>
	  <PackageLicenseExpression>MIT</PackageLicenseExpression>
	  <IncludeSymbols>True</IncludeSymbols>
	  <SymbolPackageFormat>snupkg</SymbolPackageFormat>
	  <PackageProjectUrl>https://github.com/sapozhnikovv/CacheLine.CPU.SCU</PackageProjectUrl>
	  <RepositoryUrl>https://github.com/sapozhnikovv/CacheLine.CPU.SCU</RepositoryUrl>
	  <PackageIcon>logo.jpg</PackageIcon>
	  <PackageId>CacheLine.CPU.SCU</PackageId>
	  <PackageReadmeFile>README.md</PackageReadmeFile>
	  <Version>1.0.0.0</Version>
	  <TargetFrameworks>net7.0;net8.0;net9.0</TargetFrameworks>
  </PropertyGroup>

	<ItemGroup>
		<None Include="..\README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="img\logo.jpg">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net7.0'">
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
	</ItemGroup>
</Project>
